# Copy to backend/.env and fill in. Never commit .env.

# MongoDB connection string. Required. No default.
# Local: mongodb://127.0.0.1:27017/pakka. Free hosted option: MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/pakka

# Gnani API key for Prisma STT and Timbre TTS. Required. No default.
# Get it at app.gnani.ai/voice.
GNANI_API_KEY=change-me

# Gemini API key for translation and ambiguity analysis. Required. No default.
# Get it at aistudio.google.com.
GEMINI_API_KEY=change-me

# Gemini model name. Optional. Default: gemini-2.5-flash. Change it if Google retires the model.
GEMINI_MODEL=gemini-2.5-flash

# Port the API listens on. Optional. Default: 4000.
PORT=4000

# Browser origin allowed to call the API (CORS). Optional. Default: http://localhost:5173.
FRONTEND_ORIGIN=http://localhost:5173

# Speaker languages as Gnani language codes. Optional. Defaults: gu-IN for the seller, hi-IN for the buyer.
SELLER_LANG=gu-IN
BUYER_LANG=hi-IN

# Timbre v3.0 voice names. Optional. Defaults: Shivani for the seller, Avinash for the buyer.
# Other voices are listed in the Gnani docs (docs.gnani.ai, available voices).
SELLER_VOICE=Shivani
BUYER_VOICE=Avinash
